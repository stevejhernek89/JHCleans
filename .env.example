# JHCleans.com Environment Variables
# Copy this file to .env.local and fill in values before launch

# ===========================================
# Email (Resend) — required for form submissions
# ===========================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=bookings@jhcleans.com
BOOKING_NOTIFICATION_EMAIL=

# Guardian-managed contact (founders may be minors)
GUARDIAN_EMAIL=
GUARDIAN_NAME=

# ===========================================
# Admin Portal
# ===========================================
ADMIN_PASSWORD=change-me-before-launch
ADMIN_SESSION_SECRET=

# ===========================================
# Supabase — required in production for admin dashboard persistence
# ===========================================
# Get these from Supabase Dashboard → Project Settings → API
# Both are required for admin content saves (business info, jobs, etc.)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Public anon/publishable key — required for live admin screen sharing (Realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===========================================
# Analytics (optional — disabled if not set)
# ===========================================
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# ===========================================
# AI Business Consultant (optional)
# ===========================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Hard cap on estimated API spend tracked in admin store (resets each calendar month)
OPENAI_MONTHLY_BUDGET_USD=5
# Rate limits
OPENAI_RATE_LIMIT_PER_DAY=200
OPENAI_RATE_LIMIT_PER_5_MIN=10
OPENAI_MIN_REQUEST_INTERVAL_MS=5000
OPENAI_MAX_OUTPUT_TOKENS=1000

# ===========================================
# Site URL (used for canonical URLs in production)
# ===========================================
NEXT_PUBLIC_SITE_URL=https://jhcleans.com
