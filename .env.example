# JHCleans.com Environment Variables
# Copy this file to .env.local and fill in values before launch

# ===========================================
# Email (Resend) — required for form submissions
# ===========================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=bookings@jhcleans.com
BOOKING_NOTIFICATION_EMAIL=

# Guardian-managed contact (founders may be minors)
GUARDIAN_EMAIL=
GUARDIAN_NAME=

# ===========================================
# Admin Portal
# ===========================================
ADMIN_PASSWORD=change-me-before-launch
ADMIN_SESSION_SECRET=

# ===========================================
# Supabase — required in production for admin dashboard persistence
# ===========================================
# Get these from Supabase Dashboard → Project Settings → API
# Both are required for admin content saves (business info, jobs, etc.)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ===========================================
# Analytics (optional — disabled if not set)
# ===========================================
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# ===========================================
# Site URL (used for canonical URLs in production)
# ===========================================
NEXT_PUBLIC_SITE_URL=https://jhcleans.com
